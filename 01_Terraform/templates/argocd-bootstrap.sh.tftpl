install -d -m 0700 /var/lib/bootstrap

# Public repository. Delete first so an older SSH key cannot linger in the Secret data map.
k3s kubectl -n argocd delete secret repo-kubernetes-cloudlab --ignore-not-found
k3s kubectl -n argocd create secret generic repo-kubernetes-cloudlab \
  --from-literal=type=git \
  --from-literal=url='https://github.com/aherkstroeter/kubernetes-cloudlab.git'
k3s kubectl -n argocd label secret repo-kubernetes-cloudlab \
  argocd.argoproj.io/secret-type=repository --overwrite

cat > /var/lib/bootstrap/root-app.yaml <<'ARGOCD_ROOT_APP_END'
${root_app}
ARGOCD_ROOT_APP_END
k3s kubectl apply -f /var/lib/bootstrap/root-app.yaml
