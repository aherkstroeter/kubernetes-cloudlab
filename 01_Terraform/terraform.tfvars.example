project_id    = "your-gcp-project"
cluster_name  = "homelab"
cluster_token = "change-me"
server_count  = 1
agent_count   = 0
server_type   = "e2-medium"
agent_type    = "e2-medium"

# Nodes are private. Cloud NAT is on by default so they can download k3s.
# assign_public_ip = false
# enable_nat       = true

# Install Argo CD, then let it sync the repo. Leave this unset until you want that.
# Helm runs first, then manifests, then script.
#
# bootstrap = {
#   helm_releases = [{
#     name       = "argocd"
#     repository = "https://argoproj.github.io/argo-helm"
#     chart      = "argo-cd"
#     namespace  = "argocd"
#   }]
#   manifest_urls = [
#     "https://example.com/argocd/root-app.yaml",
#   ]
# }
#
# Or a manifest only:
# bootstrap = {
#   manifest_urls = [
#     "https://raw.githubusercontent.com/argoproj/argo-cd/stable/manifests/install.yaml",
#   ]
# }
