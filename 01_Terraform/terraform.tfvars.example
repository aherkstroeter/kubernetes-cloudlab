project_id    = "your-gcp-project"
cluster_name  = "homelab"
cluster_token = "change-me"
server_count  = 1
agent_count   = 0
server_type   = "e2-medium"
agent_type    = "e2-medium"
disk_type     = "pd-standard"

# Hostname for the API certificate. Not an IP. DNS for this name is separate.
api_domain = "api.example.com"

# One MetalLB address, plus the API address which is not part of that pool.
# Another name, such as gateway, is a second floating address. Leave its hostname
# out of service_hostnames when external-dns publishes that name.
service_addresses = ["lb-0"]

# Who may open the public API and the service addresses. Empty creates no client rule.
# api_source_ranges = ["203.0.113.10/32"]

# GitHub push webhooks use a separate rule: TCP 443 from the hooks list at
# https://api.github.com/meta. That list is read on apply. Set false to omit it.
# allow_github_webhooks = true

# Nodes are private. Cloud NAT is on by default so they can download k3s.
# assign_public_ip = false
# enable_nat       = true

# install_argocd installs the Argo CD Helm chart on the first boot and applies
# 02_ArgoCD/bootstrap/root-app.yaml. Later boots leave that release for Argo CD.
# The root app applies 02_ArgoCD/appsets, and that ApplicationSet installs the platform and workload apps. Leave bootstrap null when this is true.
# The repo is public: https://github.com/aherkstroeter/kubernetes-cloudlab.git. Argo CD clones it over HTTPS.
# install_argocd = true

# Cloud DNS for the whole domain. Point the registrar nameservers at the dns_name_servers output.
# dns_domain = "example.com"
# service_hostnames = { lb-0 = "echo.lab.example.com" }

# A custom bootstrap still works when install_argocd is false. manifest_urls must be public https.
# resourceExclusionsAdditional keeps Argo CD from taking the Terraform-owned MetalLB pool.
#
# bootstrap = {
#   helm_releases = [{
#     name       = "argocd"
#     repository = "https://argoproj.github.io/argo-helm"
#     chart      = "argo-cd"
#     version    = "10.18.2"
#     namespace  = "argocd"
#     values_yaml = <<-EOT
#       configs:
#         cm:
#           resourceExclusionsAdditional:
#             - apiGroups:
#                 - metallb.io
#               kinds:
#                 - IPAddressPool
#                 - L2Advertisement
#               clusters:
#                 - "*"
#     EOT
#   }]
# }
